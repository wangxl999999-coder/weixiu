# 服务配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weixiu
DB_USER=root
DB_PASSWORD=123123

# 微信小程序配置 - 用户端
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# 微信小程序配置 - 师傅端
WX_WORKER_APPID=your_worker_wx_appid
WX_WORKER_SECRET=your_worker_wx_secret

# 微信支付配置
WX_PAY_MCHID=your_merchant_id
WX_PAY_KEY=your_api_key
WX_PAY_CERT_PATH=./config/cert/apiclient_cert.pem
WX_PAY_KEY_PATH=./config/cert/apiclient_key.pem
WX_NOTIFY_URL=https://your-domain.com/api/payment/notify

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 短信配置
SMS_ACCESS_KEY=your_sms_access_key
SMS_SECRET_KEY=your_sms_secret_key
SMS_SIGN_NAME=家政维修

# 高德地图配置
AMAP_KEY=your_amap_api_key
