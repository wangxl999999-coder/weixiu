<view class="container">
  <view class="login-header">
    <image class="logo" src="/images/logo.png" />
    <view class="app-name">家政维修</view>
    <view class="app-desc">专业的家政维修服务平台</view>
  </view>

  <view class="login-form">
    <view class="login-btn primary" bindtap="wxLogin">
      <image src="/images/wechat.png" />
      <text>微信一键登录</text>
    </view>

    <view class="phone-login">
      <view class="divider">
        <view class="line"></view>
        <text>手机号登录</text>
        <view class="line"></view>
      </view>

      <view class="form-item">
        <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
      </view>

      <button class="login-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
        微信手机号授权登录
      </button>
    </view>
  </view>

  <view class="agreement">
    <text>登录即表示同意</text>
    <text class="link">《用户协议》</text>
    <text>和</text>
    <text class="link">《隐私政策》</text>
  </view>
</view>
