.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 100rpx 60rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #999;
}

.login-form {
  margin-bottom: 60rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 30rpx;
  border: none;
  padding: 0;
}

.login-btn.primary {
  background-color: #07c160;
  color: #fff;
}

.login-btn.primary image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.phone-login {
  margin-top: 40rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background-color: #e0e0e0;
}

.divider text {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: #999;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.agreement {
  text-align: center;
  font-size: 22rpx;
  color: #999;
}

.agreement .link {
  color: #1890ff;
}
