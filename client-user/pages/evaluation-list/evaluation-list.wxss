.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.evaluation-list {
  display: flex;
  flex-direction: column;
}

.evaluation-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.evaluation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.service-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.evaluation-rating {
  display: flex;
}

.star {
  font-size: 28rpx;
  color: #ddd;
}

.star.active {
  color: #faad14;
}

.evaluation-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.evaluation-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.evaluation-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.evaluation-footer {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}
