.container {
  height: 100vh;
  background-color: #f5f5f5;
}

.content {
  display: flex;
  height: 100%;
}

.sidebar {
  width: 180rpx;
  background-color: #fff;
  border-right: 1rpx solid #f0f0f0;
}

.category-nav {
  height: 100%;
}

.nav-item {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-left: 4rpx solid transparent;
}

.nav-item.active {
  color: #1890ff;
  background-color: #f5f5f5;
  border-left-color: #1890ff;
  font-weight: 600;
}

.main {
  flex: 1;
  height: 100%;
  padding: 20rpx;
}

.service-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.service-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.service-item:last-child {
  border-bottom: none;
}

.service-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.service-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-desc {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 6rpx;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #ff4d4f;
}

.price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.price-unit {
  font-size: 20rpx;
  color: #999;
  margin-left: 4rpx;
}

.service-sales {
  font-size: 20rpx;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}
