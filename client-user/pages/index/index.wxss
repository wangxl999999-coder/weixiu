.container {
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.location {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.location-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.location-text {
  font-size: 26rpx;
  color: #333;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.content {
  height: calc(100vh - 120rpx);
}

.banner-section {
  padding: 24rpx;
}

.banner-swiper {
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.flash-section {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
}

.title-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.flash-list {
  white-space: nowrap;
}

.flash-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.flash-item:last-child {
  margin-right: 0;
}

.flash-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.flash-info {
  text-align: center;
}

.flash-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash-price {
  margin-top: 8rpx;
}

.price-current {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.price-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.coupon-section {
  margin: 24rpx;
}

.coupon-swiper {
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.coupon-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  background: linear-gradient(135deg, #ff7e5f, #feb47b);
  padding: 0 30rpx;
  border-radius: 16rpx;
}

.coupon-info {
  display: flex;
  align-items: center;
}

.coupon-title {
  font-size: 28rpx;
  color: #fff;
  margin-right: 20rpx;
}

.coupon-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.coupon-btn {
  background-color: rgba(255, 255, 255, 0.3);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #fff;
}

.category-section {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 26rpx;
  color: #333;
}

.service-section {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.service-list {
  display: flex;
  flex-direction: column;
}

.service-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.service-item:last-child {
  border-bottom: none;
}

.service-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.service-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8rpx;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff4d4f;
}

.price-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.service-sales {
  font-size: 22rpx;
  color: #999;
}

.worker-section {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.worker-list {
  display: flex;
  flex-direction: column;
}

.worker-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.worker-item:last-child {
  border-bottom: none;
}

.worker-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.worker-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.worker-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.work-years {
  font-size: 22rpx;
  color: #52c41a;
  margin-left: 12rpx;
  font-weight: normal;
}

.worker-skills {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.worker-rating {
  display: flex;
  align-items: center;
}

.rating-stars {
  display: flex;
  margin-right: 8rpx;
}

.star {
  font-size: 22rpx;
  color: #ddd;
}

.star.active {
  color: #faad14;
}

.rating-value {
  font-size: 24rpx;
  color: #faad14;
}

.worker-distance {
  font-size: 22rpx;
  color: #999;
}

.footer-tips {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #ccc;
}
