.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.form {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 120rpx;
}

.location-item {
  cursor: pointer;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
}

.value-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.value-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

.switch-item {
  justify-content: space-between;
}

.footer {
  padding: 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}
