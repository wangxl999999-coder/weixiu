<view class="container">
  <view class="form">
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input class="form-input" placeholder="请输入联系人姓名" value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-item location-item" bindtap="chooseLocation">
      <text class="form-label">所在地区</text>
      <view class="form-value">
        <text wx:if="{{detail}}" class="value-text">{{province}}{{city}}{{district}}{{detail}}</text>
        <text wx:else class="value-placeholder">请选择地址</text>
        <image class="arrow" src="/images/arrow-right.png" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="请输入详细地址，如楼栋门牌号" value="{{detail}}" bindinput="onDetailInput" maxlength="100" />
    </view>

    <view class="form-item switch-item">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{is_default}}" bindchange="onDefaultChange" color="#1890ff" />
    </view>
  </view>

  <view class="footer">
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '保存中...' : '保存'}}
    </view>
  </view>
</view>
