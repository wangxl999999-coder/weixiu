.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 160rpx;
}

.booking-content {
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #1890ff;
}

.address-section {
  cursor: pointer;
}

.address-user {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 20rpx;
}

.address-phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.no-address {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.no-address-text {
  font-size: 26rpx;
  color: #999;
}

.add-btn {
  font-size: 26rpx;
  color: #1890ff;
}

.service-info {
  display: flex;
}

.service-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.service-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.service-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
}

.worker-info {
  display: flex;
  align-items: center;
}

.worker-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.worker-detail {
  flex: 1;
}

.worker-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.worker-rating {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.rating-value {
  color: #faad14;
  margin-right: 12rpx;
}

.worker-distance {}

.worker-skills {
  font-size: 22rpx;
  color: #666;
}

.time-input {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.time-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.time-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.time-icon {
  width: 32rpx;
  height: 32rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
}

.coupon-item {
  display: flex;
  background: linear-gradient(135deg, #fff5f5, #fff);
  border: 2rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.coupon-item.selected {
  border-color: #ff4d4f;
  background: linear-gradient(135deg, #fff1f0, #fff);
}

.coupon-item.selected::after {
  content: '✓';
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
}

.coupon-left {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 2rpx dashed #ffccc7;
  margin-right: 20rpx;
}

.coupon-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.coupon-condition {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.coupon-expire {
  font-size: 20rpx;
  color: #999;
}

.remark-input {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  color: #333;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.price-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-row.total {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
  margin-top: 12rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price-value {
  font-size: 26rpx;
  color: #333;
}

.price-value.discount {
  color: #ff4d4f;
}

.price-value.total-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
}

.bar-price {
  display: flex;
  align-items: baseline;
}

.bar-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
}

.bar-total {
  font-size: 40rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.bar-btn {
  width: 280rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.bar-btn.disabled {
  opacity: 0.6;
}
