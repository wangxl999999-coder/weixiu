<template>
  <view class="flash-sale-page">
    <view class="header">
      <view class="title">限时秒杀</view>
      <view class="countdown" v-if="activeFlashSale">
        <text class="countdown-label">距结束</text>
        <view class="countdown-time">
          <text class="time-item">{{ countdown.hours }}</text>
          <text class="time-sep">:</text>
          <text class="time-item">{{ countdown.minutes }}</text>
          <text class="time-sep">:</text>
          <text class="time-item">{{ countdown.seconds }}</text>
        </view>
      </view>
    </view>

    <view class="flash-list" v-if="flashSales.length > 0">
      <view
        class="flash-item"
        v-for="item in flashSales"
        :key="item.id"
        @click="goToDetail(item)"
      >
        <view class="item-image">
          <image :src="item.image" mode="aspectFill" />
          <view class="sale-tag">秒杀</view>
          <view class="stock-tag" v-if="item.stock <= 5">仅剩{{ item.stock }}件</view>
        </view>
        <view class="item-info">
          <view class="item-name">{{ item.name }}</view>
          <view class="item-desc">{{ item.description }}</view>
          <view class="item-price">
            <view class="sale-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{ item.sale_price }}</text>
            </view>
            <view class="original-price">¥{{ item.original_price }}</view>
          </view>
          <view class="item-bottom">
            <view class="progress-bar">
              <view
                class="progress-inner"
                :style="{ width: (item.sold_count / item.stock * 100) + '%' }"
              ></view>
            </view>
            <text class="sold-text">已抢{{ item.sold_count }}%</text>
            <button
              class="buy-btn"
              :class="{ disabled: item.stock <= 0 }"
              @click.stop="handleBuy(item)"
            >
              {{ item.stock > 0 ? '立即抢' : '已抢完' }}
            </button>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" v-else>
      <image src="/images/empty.png" class="empty-image" />
      <text class="empty-text">暂无秒杀活动</text>
    </view>

    <view class="loading" v-if="loading">
      <text>加载中...</text>
    </view>
  </view>
</template>

<script>
const api = require('../../utils/api.js')
const config = require('../../utils/config.js')

Page({
  data: {
    flashSales: [],
    activeFlashSale: null,
    countdown: {
      hours: '00',
      minutes: '00',
      seconds: '00'
    },
    loading: true,
    countdownTimer: null
  },

  onLoad() {
    this.loadFlashSales()
  },

  onShow() {
    this.startCountdown()
  },

  onHide() {
    this.stopCountdown()
  },

  onUnload() {
    this.stopCountdown()
  },

  onPullDownRefresh() {
    this.loadFlashSales()
  },

  loadFlashSales() {
    this.setData({ loading: true })
    api.getFlashSaleList({ status: 1 })
      .then(res => {
        const list = res.data.list || res.data || []
        const activeItem = list.find(item => item.status === 1)
        this.setData({
          flashSales: list,
          activeFlashSale: activeItem,
          loading: false
        })
        wx.stopPullDownRefresh()
      })
      .catch(err => {
        console.error('加载秒杀活动失败:', err)
        this.setData({ loading: false })
        wx.stopPullDownRefresh()
        wx.showToast({ title: '加载失败', icon: 'none' })
      })
  },

  startCountdown() {
    this.stopCountdown()
    this.updateCountdown()
    this.data.countdownTimer = setInterval(() => {
      this.updateCountdown()
    }, 1000)
  },

  stopCountdown() {
    if (this.data.countdownTimer) {
      clearInterval(this.data.countdownTimer)
      this.setData({ countdownTimer: null })
    }
  },

  updateCountdown() {
    const { activeFlashSale } = this.data
    if (!activeFlashSale) return

    const now = Date.now()
    const endTime = new Date(activeFlashSale.end_time).getTime()
    let diff = endTime - now

    if (diff <= 0) {
      diff = 0
      this.stopCountdown()
    }

    const hours = Math.floor(diff / (1000 * 60 * 60))
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))
    const seconds = Math.floor((diff % (1000 * 60)) / 1000)

    this.setData({
      countdown: {
        hours: this.padZero(hours),
        minutes: this.padZero(minutes),
        seconds: this.padZero(seconds)
      }
    })
  },

  padZero(num) {
    return num < 10 ? '0' + num : '' + num
  },

  goToDetail(item) {
    wx.navigateTo({
      url: `/pages/service-detail/service-detail?id=${item.service_id}&flash_sale_id=${item.id}`
    })
  },

  handleBuy(item) {
    if (item.stock <= 0) {
      wx.showToast({ title: '已抢完', icon: 'none' })
      return
    }

    if (!wx.getStorageSync('user_token')) {
      wx.navigateTo({ url: '/pages/login/login' })
      return
    }

    wx.navigateTo({
      url: `/pages/booking/booking?service_id=${item.service_id}&flash_sale_id=${item.id}`
    })
  }
})
</script>

