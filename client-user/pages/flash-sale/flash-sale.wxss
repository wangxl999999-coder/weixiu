.flash-sale-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  padding: 30rpx;
  text-align: center;
  position: relative;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.countdown {
  display: inline-flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.countdown-label {
  font-size: 24rpx;
  color: #fff;
  margin-right: 15rpx;
}

.countdown-time {
  display: flex;
  align-items: center;
}

.time-item {
  background-color: #fff;
  color: #ff4d4f;
  font-size: 24rpx;
  font-weight: bold;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  min-width: 40rpx;
  text-align: center;
}

.time-sep {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  margin: 0 5rpx;
}

.flash-list {
  padding: 20rpx;
}

.flash-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  display: flex;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.item-image {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.item-image image {
  width: 100%;
  height: 100%;
}

.sale-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.stock-tag {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.item-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.sale-price {
  display: flex;
  align-items: baseline;
  color: #ff4d4f;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: bold;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #ff4d4f, #ff7875);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.sold-text {
  font-size: 20rpx;
  color: #ff4d4f;
  flex-shrink: 0;
}

.buy-btn {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  border: none;
  flex-shrink: 0;
  line-height: 1.4;
  margin: 0;
}

.buy-btn.disabled {
  background-color: #ccc;
  color: #fff;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: #999;
}
