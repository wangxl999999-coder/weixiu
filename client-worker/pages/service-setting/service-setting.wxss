.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 10rpx 0;
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
}

.value-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.value-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

.radius-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radius-item {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.radius-item.active {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #52c41a;
}

.day-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.day-item {
  width: 88rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.day-item.active {
  background-color: #52c41a;
  color: #fff;
}

.time-picker {
  flex: 1;
  display: flex;
  align-items: center;
}

.picker-text {
  padding: 12rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.time-separator {
  margin: 0 20rpx;
  font-size: 26rpx;
  color: #999;
}

.type-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.type-item.active {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #52c41a;
}

.submit-btn {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #52c41a, #389e0d);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn.disabled {
  opacity: 0.6;
}
