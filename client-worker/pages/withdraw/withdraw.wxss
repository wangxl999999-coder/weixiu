.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.balance-card {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 30rpx;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.balance-value {
  font-size: 56rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.balance-tip {
  font-size: 24rpx;
  opacity: 0.8;
}

.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
}

.amount-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e0e0e0;
  padding-bottom: 12rpx;
}

.currency {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-right: 8rpx;
}

.amount-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.all-btn {
  font-size: 24rpx;
  color: #52c41a;
  padding: 8rpx 20rpx;
  background-color: #f6ffed;
  border-radius: 20rpx;
  margin-left: 20rpx;
}

.tip {
  font-size: 24rpx;
  color: #999;
  padding-left: 160rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #52c41a, #389e0d);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-bottom: 40rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.records-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
}

.record-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.record-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin-right: 20rpx;
}

.record-status text {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-pending {
  background-color: #fff7e6;
  color: #faad14;
}

.status-success {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-fail {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.empty {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 40rpx 0;
}
