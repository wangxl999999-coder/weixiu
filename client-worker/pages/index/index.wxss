.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 60rpx 30rpx 40rpx;
}

.worker-info {
  display: flex;
  align-items: center;
}

.worker-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid #fff;
}

.worker-detail {
  flex: 1;
}

.worker-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.worker-status {
  font-size: 26rpx;
  font-weight: 500;
}

.worker-rating {
  background-color: rgba(255, 255, 255, 0.9);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #faad14;
  font-weight: 600;
}

.login-info {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  padding: 20rpx 0;
}

.stats-section {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-top: -20rpx;
}

.stat-card {
  flex: 1;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-card.income .stat-value {
  color: #52c41a;
}

.stat-card.order .stat-value {
  color: #1890ff;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #999;
}

.action-section {
  padding: 20rpx;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.action-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
}

.action-item image {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 12rpx;
}

.action-item text {
  font-size: 24rpx;
  color: #333;
}

.tips {
  margin: 20rpx;
  background-color: #fff7e6;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #ffd591;
}

.tips-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #fa8c16;
  margin-bottom: 12rpx;
}

.tips-content {
  font-size: 26rpx;
  color: #666;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
