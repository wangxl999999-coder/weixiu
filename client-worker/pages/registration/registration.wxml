<view class="container">
  <view wx:if="{{step === 1}}" class="step-content">
    <view class="step-header">
      <text class="step-title">欢迎入驻</text>
      <text class="step-desc">请填写基本信息完成注册</text>
    </view>

    <view class="form-card">
      <button class="phone-login-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">
        <image src="/images/wechat.png" />
        <text>微信手机号一键登录</text>
      </button>
      
      <view class="divider">
        <view class="line"></view>
        <text>或手动输入</text>
        <view class="line"></view>
      </view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
      </view>

      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onNameInput" />
      </view>

      <view class="form-item">
        <text class="form-label">身份证号</text>
        <input class="form-input" placeholder="请输入身份证号" maxlength="18" value="{{idCard}}" bindinput="onIdCardInput" />
      </view>

      <view class="next-btn" bindtap="nextStep">下一步</view>
    </view>
  </view>

  <view wx:elif="{{step === 2}}" class="step-content">
    <view class="step-header">
      <text class="step-title">资质认证</text>
      <text class="step-desc">请上传身份和技能证明材料</text>
    </view>

    <view class="form-card">
      <view class="form-item">
        <text class="form-label">身份证正面</text>
        <view class="upload-box" bindtap="uploadIdCard" data-type="front">
          <image wx:if="{{idCardFront}}" src="{{idCardFront}}" mode="aspectFill" />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">+</text>
            <text>点击上传</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">身份证反面</text>
        <view class="upload-box" bindtap="uploadIdCard" data-type="back">
          <image wx:if="{{idCardBack}}" src="{{idCardBack}}" mode="aspectFill" />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">+</text>
            <text>点击上传</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">技能证书(选填)</text>
        <view class="cert-list">
          <view wx:for="{{certificates}}" wx:key="index" class="cert-item">
            <image src="{{item}}" mode="aspectFill" />
            <view class="remove-btn" catchtap="removeCertificate" data-index="{{index}}">×</view>
          </view>
          <view wx:if="{{certificates.length < 3}}" class="upload-box small" bindtap="uploadCertificate">
            <text class="upload-icon">+</text>
            <text>添加证书</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">擅长技能</text>
        <view class="skill-list">
          <view wx:for="{{skillOptions}}" wx:key="index" class="skill-item {{skills.indexOf(item) > -1 ? 'active' : ''}}" bindtap="toggleSkill" data-skill="{{item}}">
            {{item}}
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">从业年限</text>
        <input class="form-input" type="number" placeholder="请输入从业年限" value="{{experience}}" bindinput="onExperienceInput" />
      </view>

      <view class="form-item">
        <text class="form-label">个人简介(选填)</text>
        <textarea class="form-textarea" placeholder="请输入个人简介" value="{{intro}}" bindinput="onIntroInput" maxlength="200" />
      </view>

      <view class="btn-group">
        <view class="prev-btn" bindtap="prevStep">上一步</view>
        <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
          {{submitting ? '提交中...' : '提交审核'}}
        </view>
      </view>
    </view>
  </view>

  <view class="agreement">
    <text>提交即表示同意</text>
    <text class="link">《师傅入驻协议》</text>
    <text>和</text>
    <text class="link">《隐私政策》</text>
  </view>
</view>
